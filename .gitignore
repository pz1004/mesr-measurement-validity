__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.log
*.out
*.synctex.gz
*.fdb_latexmk
*.fls
*.toc

# Datasets and third-party baselines are NOT vendored -- see DATA.md.
# In this working tree they are symlinks to sibling directories.
/E-MLB
/DVSCLEAN
/ECCV2024_datasets
/DVSGesture
/DVSD22
/cuke-emlb
/EDformer
/EDmamba
/sew7b-checkpoint
*.aedat
*.aedat4
*.hdf5
*.npy
*.npz
*.rar
*.zip
*.pt
*.pth

# The manuscript, its figures and the research record are not part of this release.
# They live in this working tree but are deliberately not published.
/paper/
/audit/
/docs/
/NUMBERS.md
/results/figures/

# The 1M lane of the cap sweep is a byte-identical copy of results/benchmark_emlb.json,
# which is already tracked. REPRODUCE.md documents the `cp` that recreates it.
/results/cap_sensitivity/emlb_cap_1000000.json
/results/cap_sensitivity/subset48/

# Frames, manifest and raw evaluator output that downstream_gesture_frozen regenerates;
# REPRODUCE.md documents the copy that ships the evaluator output.
/results/downstream_gesture_frozen_frames/
/results/downstream_gesture_frozen.smoke.json

# Frames and per-seed evaluator output of the tie-break check. A run that finishes deletes
# them; a failed run leaves them, and the next run refuses to start until they are cleared.
/results/downstream_gesture_tiebreak_frames/

# The same, for the matched-event check: each retention's frames are deleted once it is
# evaluated, its manifests, labels and evaluator output when the run finishes.
/results/downstream_matched_events_frames/

# Written only when a source-audit check fails, so a failing run cannot overwrite the artifact.
/results/reproducibility_audit.failed.json

# Progress of identity_audit and null_shuffle; renamed to the artifact when a run finishes.
/results/*.partial.json
